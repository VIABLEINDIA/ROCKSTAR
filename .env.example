# DhanHQ v2 credentials -- https://dhanhq.co/docs/v2/
# Generate the access token from the Dhan web/app: Profile -> DhanHQ Trading API.
# Tokens are typically valid for 24 hours and must be regenerated after that.
DHAN_ACCESS_TOKEN=your-jwt-access-token
DHAN_CLIENT_ID=your-dhan-client-id

# Optional overrides
# DHAN_BASE_URL=https://api.dhan.co/v2
# DHAN_SCRIP_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
